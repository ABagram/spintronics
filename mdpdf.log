   DEBUG: 2026-08-12 00:22:25,292:      pdf_renderer.py:  470: printSegment: CHALLENGE 35: CHARGE AND DISCHARGE - PART 1
   DEBUG: 2026-08-12 00:22:25,293:      pdf_renderer.py:  470: printSegment: BUILD A CIRCUIT WHERE S1 CHARGES C1 AND S2 DISCHARGES C1.
   DEBUG: 2026-08-12 00:22:25,296:      pdf_renderer.py:  470: printSegment: <div style="text-align: center;"><img
   DEBUG: 2026-08-12 00:22:25,297:      pdf_renderer.py:  470: printSegment: src="https://i.imgur.com/OyLc0R0.png" width="50%" /></div>
   DEBUG: 2026-08-12 00:22:25,298:      pdf_renderer.py:  470: printSegment: Yikes
   DEBUG: 2026-08-12 00:22:25,299:      pdf_renderer.py:  470: printSegment: !
   DEBUG: 2026-08-12 00:22:25,300:      pdf_renderer.py:  470: printSegment:  Just don
   DEBUG: 2026-08-12 00:22:25,301:      pdf_renderer.py:  470: printSegment: '
   DEBUG: 2026-08-12 00:22:25,301:      pdf_renderer.py:  470: printSegment: t turn 
   DEBUG: 2026-08-12 00:22:25,302:      pdf_renderer.py:  470: printSegment: both
   DEBUG: 2026-08-12 00:22:25,303:      pdf_renderer.py:  470: printSegment:  switches on at the same time
   DEBUG: 2026-08-12 00:22:25,304:      pdf_renderer.py:  470: printSegment: !
