   DEBUG: 2026-08-12 00:22:24,170:      pdf_renderer.py:  470: printSegment: AVAILABLE PARTS
   DEBUG: 2026-08-12 00:22:24,171:      pdf_renderer.py:  470: printSegment: l
   DEBUG: 2026-08-12 00:22:24,172:      pdf_renderer.py:  470: printSegment: 1 × 1000 Ω
   DEBUG: 2026-08-12 00:22:24,173:      pdf_renderer.py:  470: printSegment: l
   DEBUG: 2026-08-12 00:22:24,174:      pdf_renderer.py:  470: printSegment: 1 × Chain
